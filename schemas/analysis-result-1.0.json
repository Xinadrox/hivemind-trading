{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivemind.local/schemas/analysis-result-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "status", "model", "prompt_version", "input_fingerprint", "analysis"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{10,64}$"},
    "status": {"enum": ["OK", "INSUFFICIENT_DATA", "REJECTED"]},
    "model": {"type": "object", "additionalProperties": false, "required": ["provider", "name"], "properties": {"provider": {"type": "string", "minLength": 1, "maxLength": 80}, "name": {"type": "string", "minLength": 1, "maxLength": 120}}},
    "prompt_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$"},
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["summary", "confidence", "signals", "risks", "next_step"], "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 2000}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "signals": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "risks": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}}, "next_step": {"enum": ["NO_ACTION", "REVIEW", "COLLECT_MORE_DATA"]}}}
  }
}